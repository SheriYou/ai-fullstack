# 复制为 config.env 后填写；不要提交真实密钥。

# --- Bot webhook ---
# 可使用 BOT_URL，或兼容旧变量 BOT_TEST_API_URL。
BOT_URL=https://test-paas.transsion.com/whatsapp-bot-service
BOT_TEST_API_URL=
BOT_CHANNEL_KEY=ch_wa_01

# --- MySQL 日志读取 ---
# docker：通过 docker exec 访问本地容器；direct：通过 MySQL TCP 直连 Test/UAT。
MYSQL_MODE=docker
MYSQL_CONTAINER=cpm-bot-mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=whatsapp
MYSQL_PASSWORD=whatsapp123
MYSQL_DB=whatsapp_bot

# --- 可选 LLM 判定（仅 --llm-judge / --llm-tag-judge 需要）---
# 若未填写 DEEPSEEK_*，执行判定会回退使用 LLM_API_KEY / LLM_API_BASE / LLM_MODEL。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 历史兼容变量（当前执行链路不直接使用）---
BOT_WEBHOOK_SECRET=
BOT_BUSINESS_LINE_ID=
LLM_API_KEY=
LLM_API_BASE=https://newapi-hk.transsion.com/v1
LLM_MODEL=gpt-5.4
SOBOT_API_BASE=
